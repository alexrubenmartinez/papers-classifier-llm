      "locked": false,
      "text": "▼ C. SYNC + DASHBOARD (12–14)",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "▼ C. SYNC + DASHBOARD (12–14)",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t111",
      "type": "text",
      "x": 1290,
      "y": 850,
      "width": 540,
      "height": 160,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB11",
      "roundness": null,
      "seed": 104107,
      "version": 1,
      "versionNonce": 205883,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "12. examen-api → MinIO Silver   GET silver.parquet (post-rescore)\n\n13. examen-api → MongoDB   deleteMany papers + insertMany\n    (2000 docs desde silver.parquet · ~5s)\n\n14. Browser ⇄ stack   GET /api/papers · /api/health · /api/jobs/:id\n    Dashboard refetch automático tras navegación\n    (hard refresh si quedó en cache)",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "12. examen-api → MinIO Silver   GET silver.parquet (post-rescore)\n\n13. examen-api → MongoDB   deleteMany papers + insertMany\n    (2000 docs desde silver.parquet · ~5s)\n\n14. Browser ⇄ stack   GET /api/papers · /api/health · /api/jobs/:id\n    Dashboard refetch automático tras navegación\n    (hard refresh si quedó en cache)",
      "lineHeight": 1.25,
      "autoResize": true
    },
