# Copialo a .env y completá con los valores reales. No commitees el .env.

# ─────── VPS donde corre el container ───────
VPS_HOST=178.238.233.75
VPS_DOMAIN=group-one.duckdns.org
VPS_USER=root
VPS_PASS=replace-me

# ─────── MinIO (sobre tunnel SSH local o red Docker interna en VPS) ───────
# Para correr local: MINIO_ENDPOINT=http://127.0.0.1:9000 (requiere ssh -L 9000:127.0.0.1:9000)
# Para correr en VPS dentro del container: MINIO_ENDPOINT=http://minio:9000 (resuelve por red Docker `stack_web`)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-me

# ─────── Bucket y prefijos del clasificador ───────
BUCKET=examen-parcial
GROUP_PREFIX=grupo3_ciberseguridad
