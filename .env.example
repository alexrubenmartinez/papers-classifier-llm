# Copialo a .env y completá con los valores de TU VPS.
# Nada acá se sube al repo.

# ---------------------------------------------------------------------------
# VPS al que se despliega todo
# ---------------------------------------------------------------------------
VPS_HOST=tu-vps.example.com
VPS_DOMAIN=tu-vps.example.com
VPS_USER=root

# ---------------------------------------------------------------------------
# API key compartida (el examinador / la UI la usan vía X-API-Key)
# Generala con: openssl rand -hex 32
# ---------------------------------------------------------------------------
API_KEY=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Mongo (debe estar corriendo en el VPS, container `mongodb`)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://admin:tu_password@mongodb:27017/?authSource=admin
MONGO_DB=examen_api

# ---------------------------------------------------------------------------
# MinIO (container `minio` con credenciales propias)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=tu_password
MINIO_BUCKET=papers-corpus
MINIO_PREFIX=uploads

# ---------------------------------------------------------------------------
# Ollama (modelo a usar por defecto)
# ---------------------------------------------------------------------------
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b

# ---------------------------------------------------------------------------
# Subdominios donde se exponen los 3 servicios
# (deben resolver al VPS y el cert wildcard debe cubrirlos)
# ---------------------------------------------------------------------------
OLLAMA_DOMAIN=ollama-api.tu-vps.example.com
API_DOMAIN=api.tu-vps.example.com
UI_DOMAIN=ui.tu-vps.example.com
